<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	id="WebApp_ID" version="3.0">
	<display-name>workshop-servlet-khadri-mart</display-name>

	<welcome-file-list>
		<welcome-file>main.jsp</welcome-file>
	</welcome-file-list>
	<servlet>
		<servlet-name>vegadd</servlet-name>
		<servlet-class>com.khadri.mart.vegetable.servlet.AddVegetableServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>vegadd</servlet-name>
		<url-pattern>/vegAdd</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>vegaddJsp</servlet-name>
		<jsp-file>/veg_add.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>vegaddJsp</servlet-name>
		<url-pattern>/veg_add</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>modify</servlet-name>
		<servlet-class>com.khadri.mart.vegetable.servlet.ModifyVegetableServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>modify</servlet-name>
		<url-pattern>/veg_modify</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>vegmodifyJsp</servlet-name>
		<jsp-file>/veg_modify.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>vegmodifyJsp</servlet-name>
		<url-pattern>/vegModify</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>vegviewJsp</servlet-name>
		<jsp-file>/veg_view.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>vegviewJsp</servlet-name>
		<url-pattern>/veg_view</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>viewallJsp</servlet-name>
		<jsp-file>/veg_viewall.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>viewallJsp</servlet-name>
		<url-pattern>/vegViewAll</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>vegdelete</servlet-name>
		<servlet-class>com.khadri.mart.vegetable.servlet.DeleteVegetableServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>vegdelete</servlet-name>
		<url-pattern>/vegDelete</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>vegdeleteJsp</servlet-name>
		<jsp-file>/veg_delete.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>vegdeleteJsp</servlet-name>
		<url-pattern>/veg_delete</url-pattern>
	</servlet-mapping>
	
	<context-param>
		<param-name>Url</param-name>
		<param-value>jdbc:mysql://localhost:3306/2024_batch</param-value>
	</context-param>
	<context-param>
		<param-name>User</param-name>
		<param-value>root</param-value>
	</context-param>
	<context-param>
		<param-name>Password</param-name>
		<param-value>root</param-value>
	</context-param>
</web-app>