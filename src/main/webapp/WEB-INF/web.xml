<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">
	<display-name>workshop-servlet-khadri-mart</display-name>
	<welcome-file-list>
		<welcome-file>main.html</welcome-file>
	</welcome-file-list>

	<servlet>
		<servlet-name>veg_add</servlet-name>
		<servlet-class>com.khadri.mart.vegetable.servlet.AddVegetableServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>veg_add</servlet-name>
		<url-pattern>/vegAdd</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>modify</servlet-name>
		<servlet-class>com.khadri.mart.vegetable.servlet.ModifyVegetableServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>modify</servlet-name>
		<url-pattern>/vegModify</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>veg_modify</servlet-name>
		<jsp-file>/veg_modify_page.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>veg_modify</servlet-name>
		<url-pattern>/vegModifyPage</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>veg_view</servlet-name>
		<jsp-file>/veg_view.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>veg_view</servlet-name>
		<url-pattern>/vegView</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>veg_viewall</servlet-name>
		<jsp-file>/veg_viewall.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>veg_viewall</servlet-name>
		<url-pattern>/vegViewAll</url-pattern>
	</servlet-mapping>

</web-app>